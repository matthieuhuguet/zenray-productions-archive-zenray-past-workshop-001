  <path d="M630 100 C 700 120, 760 170, 800 214" fill="none" stroke="#3a3f45" stroke-width="1.6" marker-end="url(#a)"/>
  <text x="690" y="128" font-size="13" fill="#1d2126">2 fetch, sha256</text>
  <path d="M630 290 L738 290" fill="none" stroke="#2f7fd8" stroke-width="1.6" marker-end="url(#b)"/>
  <text x="640" y="282" font-size="13" fill="#2f7fd8">2 recollés</text>

  <!-- 3 rendre -->
  <path d="M820 344 C 800 420, 700 460, 632 466" fill="none" stroke="#3a3f45" stroke-width="1.6" marker-end="url(#a)"/>
  <text x="742" y="420" font-size="13" fill="#1d2126">3 return, reçu</text>

  <!-- 4 rapatrier -->
  <path d="M380 470 C 300 466, 190 430, 160 346" fill="none" stroke="#3a3f45" stroke-width="1.6" marker-end="url(#a)"/>
  <text x="196" y="456" font-size="13" fill="#1d2126">4 pull, rien d'écrasé</text>

  <!-- index -->
  <path d="M380 70 L262 70" fill="none" stroke="#3a3f45" stroke-width="1.2" stroke-dasharray="4 4" marker-end="url(#a)"/>
  <text x="272" y="60" font-size="12" fill="#5b636b">Index.json</text>
