  <rect x="740" y="216" width="210" height="128" rx="16" fill="#ffffff" stroke="#1d2126" stroke-width="1.5"/>
  <text x="845" y="248" text-anchor="middle" font-size="18" fill="#1d2126">VM Claude cloud</text>
