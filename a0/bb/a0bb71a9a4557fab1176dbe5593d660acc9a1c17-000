#!/usr/bin/env node
// ZenRay Past synthesis (ProjectSynthesis contract of 4 November 2026): a clean title, three short paragraphs, two
// 1920x1080 schemas, nothing else. Every number comes from a dated snapshot of the base and from the bench files, and
// `verify` re-reads the page and fails if one number differs. 9 November 2026, 21:10 Europe/Paris.
// FR : synthèse de ZenRay Past ; chaque nombre vient d'un relevé daté ou des bancs, et `verify` le recontrôle.
//   node Scripts/BuildSynthesis.mjs snapshot | build | verify [file]
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import path from 'node:path'

const W = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..')
const REPO = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPast'
// 9 November 2026: everything in Adobe Clean (Matthieu's rule of 9 November 2026), served from ZenRayProgress. / FR : tout en Adobe Clean.
const FONTS = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/public/fonts'
const OUT = path.join(W, 'Articles/index.html')
const SNAP = path.join(W, 'Articles/snapshot.json')
const fr = (n) => Number(n).toLocaleString('fr-FR').replace(/ /g, ' ')
const dec = (n, d = 3) => Number(n).toFixed(d).replace('.', ',')

async function snapshot() {
  const { openDb } = await import(path.join(REPO, 'src/db.mjs'))
  const db = openDb()
  const by = Object.fromEntries(db.prepare('SELECT source, COUNT(*) n FROM data_points GROUP BY source').all().map((r) => [r.source, r.n]))
  const s = {
    takenAt: new Date().toISOString(), sources: by,
    points: db.prepare('SELECT COUNT(*) n FROM data_points').get().n,
    memories: db.prepare('SELECT COUNT(*) n FROM memories').get().n,
    vectors: db.prepare('SELECT COUNT(*) n FROM embeddings').get().n,
    supersedes: db.prepare("SELECT COUNT(*) n FROM links WHERE rel = 'supersedes'").get().n,
  }
  writeFileSync(SNAP, JSON.stringify(s, null, 1))
  return s
}

function numbers() {
  const s = JSON.parse(readFileSync(SNAP, 'utf8'))
  const reader = JSON.parse(readFileSync(path.join(REPO, 'bench/reader-score-9-November-2026.json'), 'utf8'))
  const vec = JSON.parse(readFileSync(path.join(REPO, 'bench/vectors-9-November-2026.json'), 'utf8')).results
  return { s, reader, vec }
}

const font = (file) => `url(data:font/woff2;base64,${readFileSync(path.join(FONTS, file)).toString('base64')}) format('woff2')`

// 9 November 2026: a compact source row, title and number only. / FR : ligne de source compacte.
function sourceBox(x, y, w, h, title, value) {
  return `<g class="box"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="18"/>
  <text class="t" x="${x + 24}" y="${y + 38}">${title}</text>
  <text class="n" x="${x + 24}" y="${y + 88}">${value}</text></g>`
}

function box(x, y, w, h, title, value, sub, cls = '') {
  return `<g class="box ${cls}"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="18"/>
  <text class="t" x="${x + 24}" y="${y + 40}">${title}</text>
  ${value ? `<text class="n" x="${x + 24}" y="${y + 92}">${value}</text>` : ''}
  ${sub ? `<text class="s" x="${x + 24}" y="${y + h - 22}">${sub}</text>` : ''}</g>`
}
const arrow = (x1, y1, x2, y2, cls = '') => `<path class="a ${cls}" d="M${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}" marker-end="url(#m${cls ? '2' : '1'})"/>`

function chain({ s, vec }) {
  // 9 November 2026, 17:40: eight sources (documents, rules and skills added), compact rows that fit the 1080 px height.
  // FR : huit sources, en lignes compactes qui tiennent dans les 1080 px.
  const src = [['Journal', s.sources.progress], ['Notes Memory', s.sources.memory], ['Règles et skills', s.sources.doctrine],
    ['Commits', s.sources.git], ['Pull requests', s.sources.pr], ['Séances des agents', s.sources.conversations],
    ['Notes du jour du site', s.sources.notes], ['Documents', s.sources.documents]].filter(([, n]) => n != null)
  const ROW = { top: 70, step: 118, h: 104 }
  const left = src.map(([t, n], i) => sourceBox(60, ROW.top + i * ROW.step, 400, ROW.h, t, fr(n))).join('\n')
  const arrowsIn = src.map((_, i) => arrow(460, ROW.top + i * ROW.step + ROW.h / 2, 600, 540)).join('\n')
  const e5 = vec.find((v) => v.kept), ctx = vec.filter((v) => !v.kept)
  return `<svg viewBox="0 0 1920 1080" width="1920" height="1080" role="img" aria-label="Chaîne de valeur de ZenRay Past">
  <defs><marker id="m1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5L0 10z" class="mk"/></marker>
  <marker id="m2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0L10 5L0 10z" class="mk2"/></marker></defs>
  ${left}
  ${arrowsIn}
  ${box(600, 460, 330, 160, 'Points datés', fr(s.points), 'texte brut, date réelle')}
  ${arrow(930, 540, 1010, 330)}${arrow(930, 540, 1010, 700)}
  ${box(1010, 250, 330, 160, 'Souvenirs', fr(s.memories), `${fr(s.supersedes)} corrections reliées`)}
  ${box(1010, 620, 330, 160, 'Vecteurs locaux', fr(s.vectors), `e5, MRR ${dec(e5.mrr)}`)}
  ${arrow(1340, 330, 1420, 520)}${arrow(1340, 700, 1420, 560)}
  ${box(1420, 440, 440, 200, 'Rappel sous budget', '≤ 6 000', 'tokens : mots, sens et temps', 'hi')}
  ${arrow(1640, 440, 1640, 330)}${arrow(1640, 640, 1640, 760)}
  ${box(1420, 160, 440, 170, 'Agents', 'MCP', 'Claude Code, Codex, Antigravity')}
  ${box(1420, 760, 440, 170, 'Onglet Past', '3D', 'ZenRayProgress')}
  ${box(600, 860, 330, 150, 'Apple contextuel', `MRR ${dec(ctx[0].mrr)}`, 'écarté', 'off')}
  ${box(1010, 860, 330, 150, 'Apple phrases', `MRR ${dec(ctx[1].mrr)}`, 'écarté', 'off')}
  ${box(600, 70, 330, 150, 'ZenRay Knowledge', '×', 'abandonné', 'off')}
  </svg>`
}

function bench({ reader }) {
  const max = reader.baseline.tokensPerQuestion
  const bar = (y, label, v, cls) => `<text class="t" x="80" y="${y - 18}">${label}</text>
  <rect class="bar ${cls}" x="80" y="${y}" width="${Math.round(1100 * v / max)}" height="70" rx="12"/>
  <text class="n" x="${100 + Math.round(1100 * v / max)}" y="${y + 56}">${fr(v)}</text>`
  return `<svg viewBox="0 0 1920 1080" width="1920" height="1080" role="img" aria-label="Banc du 9 novembre 2026">
  <text class="h" x="80" y="120">Tokens lus par question</text>
  ${bar(220, 'Claude Code seul, recherche par grep', reader.baseline.tokensPerQuestion, '')}
  ${bar(400, 'ZenRay Past, preuves sous budget', reader.meanTokensPerQuestion, 'hi')}
  <text class="h" x="80" y="640">Réponses justes</text>
  ${box(80, 690, 520, 300, 'Claude Code seul', `${reader.baseline.correct} / ${reader.baseline.of}`, 'questions connues', '')}
  ${box(680, 690, 520, 300, 'ZenRay Past', `${reader.known.correct} / ${reader.known.of}`, 'questions connues', 'hi')}
  ${box(1280, 690, 560, 300, 'ZenRay Past', `${reader.heldout.correct} / ${reader.heldout.of}`, 'questions tenues à l’écart', 'hi')}
  </svg>`
}

