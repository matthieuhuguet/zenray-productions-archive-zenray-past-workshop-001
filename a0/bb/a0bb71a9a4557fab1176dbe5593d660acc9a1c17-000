}

// Every number the page shows must equal the snapshot or the bench files. / FR : chaque nombre affiché est recontrôlé.
function verify(file = OUT) {
  const page = readFileSync(file, 'utf8')
  const { s, reader, vec } = numbers()
  const must = [fr(s.points), fr(s.memories), fr(s.vectors), fr(s.supersedes), ...Object.values(s.sources).map(fr),
    fr(reader.meanTokensPerQuestion), fr(reader.baseline.tokensPerQuestion), `${reader.heldout.correct} / ${reader.heldout.of}`,
    `${reader.known.correct} / ${reader.known.of}`, `${reader.baseline.correct} / ${reader.baseline.of}`, ...vec.map((v) => `MRR ${dec(v.mrr)}`)]
  const missing = must.filter((m) => !page.includes(m))
  if (missing.length) { console.error('verify FAILED, missing:', missing); process.exit(1) }
  console.log(`verify ok: ${must.length} numbers found in ${path.basename(file)}`)
}

const cmd = process.argv[2]
if (cmd === 'snapshot') console.log(JSON.stringify(await snapshot()))
else if (cmd === 'build') { if (!existsSync(SNAP)) await snapshot(); writeFileSync(OUT, html(numbers())); console.log('wrote', OUT); process.exit(0) }
else if (cmd === 'verify') verify(process.argv[3])
else { console.error('usage: snapshot | build | verify [file]'); process.exit(2) }
