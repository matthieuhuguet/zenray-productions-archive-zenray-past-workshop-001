    model,  # any model Pydantic AI supports
    deps_type=str,  # the signed-in user's identity
    instructions="Call recall_memory before you answer questions about people, decisions or history.",
)

@agent.tool
def remember(ctx: RunContext[str], text: str, happened_at: str) -> dict:
    """Store timestamped source text, readable by the whole project, authored by the current user."""
    return requests.post(f"{BASE}/ingest", headers=HEADERS, json={
        "content": text,
        "timestamp": happened_at,
        "identity": ctx.deps,
    }).json()

@agent.tool
def recall_memory(ctx: RunContext[str], question: str) -> dict:
    """Return ranked documents with dates and source excerpts for the current user."""
    return requests.post(f"{BASE}/recall", headers=HEADERS, json={
        "query": question,
        "identity": ctx.deps,
    }).json()

result = agent.run_sync("What did we decide about the Q4 budget?", deps="demo-user")
```

